<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>AutoPano - one-button seamless mosaic of linear deep-sky panels (plate solving, star refinement, photometry, seams, noise matching, seam editing).</p>
   </description>
   <platform os="all" arch="noarch" version="1.9.5:1.9.99">
      <package fileName="AutoPano-1.0.3-20261016.zip" sha1="eb804bfa149b36845ce921ba427f3bebad668b22" type="script" releaseDate="20261016">
         <title>AutoPano 1.0.3</title>
         <description>
            <p>GraXpert option: the background model is computed on an 8x reduced copy of the mosaic and applied to the full-resolution image - no more bright patches over noisier panels (the mosaic stays full size and full detail); empty corners are extended smoothly for GraXpert.</p>
            <p>After installation the script is available as Script &gt; Utilities &gt; AutoPano.</p>
         </description>
      </package>
   </platform>
</xri>
